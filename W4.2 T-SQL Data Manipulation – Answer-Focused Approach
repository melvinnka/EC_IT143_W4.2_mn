/******************************************************************************
STEP 1
Question:
How many Samsung phone models were released each year?
******************************************************************************/

/******************************************************************************
STEP 2
Answer Plan:
1. Filter Samsung records.
2. Group by ReleaseYear.
3. Count distinct phone models.
******************************************************************************/

/******************************************************************************
STEP 3 - Ad Hoc Query
******************************************************************************/

SELECT
    ReleaseYear,
    COUNT(DISTINCT ModelID) AS TotalModels
FROM Samsung_iPhone_Specifications
WHERE Brand = 'Samsung'
GROUP BY ReleaseYear
ORDER BY ReleaseYear;

/******************************************************************************
STEP 4 - Create View
******************************************************************************/

CREATE OR ALTER VIEW v_samsung_models_by_year_mn
AS
SELECT
    ReleaseYear,
    COUNT(DISTINCT ModelID) AS TotalModels
FROM Samsung_iPhone_Specifications
WHERE Brand = 'Samsung'
GROUP BY ReleaseYear;
GO

SELECT *
FROM v_samsung_models_by_year_mn;


/******************************************************************************
STEP 5.1 - Create Table from View
******************************************************************************/

DROP TABLE IF EXISTS t_samsung_models_by_year_mn;

SELECT *
INTO t_samsung_models_by_year_mn
FROM v_samsung_models_by_year_mn;


/******************************************************************************
STEP 5.2 - Refine Table Structure
******************************************************************************/

DROP TABLE IF EXISTS t_samsung_models_by_year_mn;

CREATE TABLE t_samsung_models_by_year_mn
(
    ReleaseYear INT PRIMARY KEY,
    TotalModels INT NOT NULL
);


/******************************************************************************
STEP 6 - Load Table
******************************************************************************/

TRUNCATE TABLE t_samsung_models_by_year_mn;

INSERT INTO t_samsung_models_by_year_mn
(
    ReleaseYear,
    TotalModels
)
SELECT
    ReleaseYear,
    TotalModels
FROM v_samsung_models_by_year_mn;

SELECT *
FROM t_samsung_models_by_year_mn;


/******************************************************************************
STEP 7 - Create Stored Procedure
******************************************************************************/

CREATE OR ALTER PROCEDURE p_load_samsung_models_by_year_mn
AS
BEGIN

    SET NOCOUNT ON;

    TRUNCATE TABLE t_samsung_models_by_year_mn;

    INSERT INTO t_samsung_models_by_year_mn
    (
        ReleaseYear,
        TotalModels
    )
    SELECT
        ReleaseYear,
        TotalModels
    FROM v_samsung_models_by_year_mn;

/******************************************************************************
STEP 8 - Execute Stored Procedure
******************************************************************************/

EXEC p_load_samsung_models_by_year_mn;

SELECT *
FROM t_samsung_models_by_year_mn;


/******************************************************************************
******************************************************************************
COMMUNITY 2 - APPLE IPHONES
******************************************************************************
******************************************************************************/

/******************************************************************************
STEP 1
Question:
What is the average price of Apple iPhones by release year?
******************************************************************************/

/******************************************************************************
STEP 2
Answer Plan:
1. Filter Apple records.
2. Group by ReleaseYear.
3. Calculate average price.
******************************************************************************/

/******************************************************************************
STEP 3 - Ad Hoc Query
******************************************************************************/

SELECT
    ReleaseYear,
    AVG(Price) AS AveragePrice
FROM Samsung_iPhone_Specifications
WHERE Brand = 'Apple'
GROUP BY ReleaseYear
ORDER BY ReleaseYear;


/******************************************************************************
STEP 4 - Create View
******************************************************************************/

CREATE OR ALTER VIEW v_apple_avg_price_by_year_mn
AS
SELECT
    ReleaseYear,
    AVG(Price) AS AveragePrice
FROM Samsung_iPhone_Specifications
WHERE Brand = 'Apple'
GROUP BY ReleaseYear;


/******************************************************************************
STEP 5 - Create Table
******************************************************************************/

DROP TABLE IF EXISTS t_apple_avg_price_by_year_mn;


CREATE TABLE t_apple_avg_price_by_year_mn
(
    ReleaseYear INT PRIMARY KEY,
    AveragePrice DECIMAL(10,2) NOT NULL
);


/******************************************************************************
STEP 6 - Load Table
******************************************************************************/

INSERT INTO t_apple_avg_price_by_year_mn
(
    ReleaseYear,
    AveragePrice
)
SELECT
    ReleaseYear,
    AveragePrice
FROM v_apple_avg_price_by_year_mn;


/******************************************************************************
STEP 7 - Stored Procedure
******************************************************************************/

CREATE OR ALTER PROCEDURE p_load_apple_avg_price_by_year_mn
AS
BEGIN

    SET NOCOUNT ON;

    TRUNCATE TABLE t_apple_avg_price_by_year_mn;

    INSERT INTO t_apple_avg_price_by_year_mn
    (
        ReleaseYear,
        AveragePrice
    )
    SELECT
        ReleaseYear,
        AveragePrice
    FROM v_apple_avg_price_by_year_mn;

/******************************************************************************
STEP 8 - Execute Stored Procedure
******************************************************************************/

EXEC p_load_apple_avg_price_by_year_mn;

SELECT *
FROM t_apple_avg_price_by_year_mn;

/******************************************************************************
HELLO WORLD
******************************************************************************/

/******************************************************************************
Step 1: Start with a Question

Question:
Can SQL Server display the text 'Hello World'?
******************************************************************************/

/******************************************************************************
Step 2: Begin Creating an Answer

Answer Plan:
1. Create a query that returns Hello World.
2. Store the query in a view.
3. Store the view results in a table.
4. Load the table through a stored procedure.
******************************************************************************/

/******************************************************************************
Step 3: Create an Ad Hoc SQL Query
******************************************************************************/

SELECT
    'Hello World' AS Greeting;


/******************************************************************************
Step 4: Turn the Query Into a View
******************************************************************************/

CREATE OR ALTER VIEW v_hello_world_mn
AS
SELECT
    'Hello World' AS Greeting;


/******************************************************************************
Step 5: Turn the View Into a Table
******************************************************************************/

DROP TABLE IF EXISTS t_hello_world_mn;


CREATE TABLE t_hello_world_mn
(
    Greeting VARCHAR(50) NOT NULL
);


/******************************************************************************
Step 6: Load the Table From the View
******************************************************************************/

TRUNCATE TABLE t_hello_world_mn;

INSERT INTO t_hello_world_mn
(
    Greeting
)
SELECT
    Greeting
FROM v_hello_world_mn;


/******************************************************************************
Step 7: Create a Stored Procedure
******************************************************************************/

CREATE OR ALTER PROCEDURE p_load_hello_world_mn
AS
BEGIN

    SET NOCOUNT ON;

    TRUNCATE TABLE t_hello_world_mn;

    INSERT INTO t_hello_world_mn
    (
        Greeting
    )
    SELECT
        Greeting
    FROM v_hello_world_mn;



/******************************************************************************
Step 8: Execute Stored Procedure
******************************************************************************/

EXEC p_load_hello_world_mn;


SELECT *
FROM t_hello_world_mn;

